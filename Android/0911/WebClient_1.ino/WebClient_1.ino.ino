#include <ESP8266WiFi.h>
#include <WiFiClient.h>

#include <AM2302-Sensor.h>
#include <Ticker.h>

// ============================================================
// AM2302 / DHT22
// GPIO4 = NodeMCU D2
// ============================================================
AM2302::AM2302_Sensor am2302(4);


// ============================================================
// Wi-Fi
// ============================================================
const char* ssid = "thmrb311";
const char* password = "thmrbthmrb";


// ============================================================
// WiFi Client
// ============================================================
WiFiClient client;

const int http_port = 80;


// ============================================================
// ThingSpeak
// ============================================================
char serverName_thingspeak[] = "api.thingspeak.com";

// 你的 ThingSpeak Write API Key
const char* writeAPIKey = "GI5MENZRYXUAZY04";


// ============================================================
// Ticker
// ============================================================
Ticker timer;


// ============================================================
// 每 15 秒設定一次
// ============================================================
volatile bool readFlag = false;


// ============================================================
// Timer Callback
// ============================================================
void setFlag()
{
    readFlag = true;
}


// ============================================================
// setup()
// ============================================================
void setup()
{
    Serial.begin(115200);

    pinMode(2, OUTPUT);
    digitalWrite(2, LOW);


    // ========================================================
    // Wi-Fi 連線
    // ========================================================
    WiFi.begin(ssid, password);

    Serial.println("");

    while (WiFi.status() != WL_CONNECTED)
    {
        delay(500);

        Serial.print(".");
    }


    Serial.println("");

    Serial.print("Connected to : ");
    Serial.println(ssid);

    Serial.print("IP address : ");
    Serial.println(WiFi.localIP());


    // ========================================================
    // 【修改】
    // 老師原本：
    //
    // timer.attach(6.0, setFlag);
    //
    // 改成每 15 秒觸發一次
    // ========================================================
    timer.attach(15.0, setFlag);


    // ========================================================
    // 如果希望開機後馬上先讀一次
    // 設定 readFlag = true
    // ========================================================
    readFlag = true;
}


// ============================================================
// loop()
// ============================================================
void loop()
{
    // ========================================================
    // 每 15 秒 Timer 會讓 readFlag = true
    // ========================================================
    if (readFlag)
    {
        // 先清除 Flag
        readFlag = false;


        // ====================================================
        // 讀取 AM2302 / DHT22
        // ====================================================
        int status = am2302.read();


        // ====================================================
        // status == 0 表示讀取成功
        // ====================================================
        if (status == 0)
        {
            // ================================================
            // 取得溫度
            // ================================================
            float t = am2302.get_Temperature();


            // ================================================
            // 取得溼度
            // ================================================
            float h = am2302.get_Humidity();


            // ================================================
            // Serial Monitor 顯示資料
            // ================================================
            Serial.println("==========================");

            Serial.println("DHT 22 data");

            Serial.print("temp = ");
            Serial.println(t);

            Serial.print("hum = ");
            Serial.println(h);


            // ================================================
            // 【新增】
            // 把真正讀到的溫度、溼度送 ThingSpeak
            //
            // field1 = 溫度
            // field2 = 溼度
            // ================================================
            client_send(t, h);


            Serial.println();
        }
        else
        {
            // ================================================
            // AM2302 讀取失敗
            // ================================================
            Serial.print("AM2302 read error, status = ");
            Serial.println(status);
        }

    } // end of readFlag
}


// ============================================================
// ThingSpeak 傳送函式
//
// t = 溫度 -> field1
// h = 溼度 -> field2
// ============================================================
void client_send(float t, float h)
{
    Serial.println("Link to thingspeak");


    // ========================================================
    // 連線 ThingSpeak
    // ========================================================
    if (client.connect(serverName_thingspeak, http_port))
    {
        Serial.println("connected");


        // ====================================================
        // 【修改】
        // 動態產生 GET Request
        //
        // 假設：
        // t = 27.5
        // h = 65.2
        //
        // 產生：
        // /update?api_key=xxx&field1=27.5&field2=65.2
        // ====================================================
        String sendData_write =
            "GET /update?api_key=";

        sendData_write += writeAPIKey;

        sendData_write += "&field1=";

        sendData_write += String(t, 1);

        sendData_write += "&field2=";

        sendData_write += String(h, 1);

        sendData_write += " HTTP/1.1\r\n";


        // ====================================================
        // 印出實際傳送內容
        // ====================================================
        Serial.print("Send : ");
        Serial.print(sendData_write);


        // ====================================================
        // 傳送 GET Request
        // ====================================================
        client.print(sendData_write);

        delay(100);


        // ====================================================
        // Host
        // ====================================================
        client.print("Host: api.thingspeak.com\r\n");

        delay(100);


        // ====================================================
        // Connection
        // ====================================================
        client.print("Connection: close\r\n\r\n");


        Serial.println("ThingSpeak data sent");

        Serial.print("field1 = ");
        Serial.println(t);

        Serial.print("field2 = ");
        Serial.println(h);
    }
    else
    {
        // ====================================================
        // ThingSpeak 連線失敗
        // ====================================================
        Serial.println("ThingSpeak connection failed");
    }


    // ========================================================
    // 等待 ThingSpeak 處理
    // ========================================================
    delay(1000);


    // ========================================================
    // 關閉連線
    // ========================================================
    client.stop();
}
