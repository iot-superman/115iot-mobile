<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".AccActivity">

    <TextView
        android:id="@+id/textView_accData"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:layout_marginBottom="28dp"
        android:fontFamily="monospace"
        android:gravity="start"
        android:lineSpacingExtra="8dp"
        android:text="X: 0.00\nY: 0.00\nZ: 0.00"
        android:textColor="@android:color/black"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/iv_up"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 方向指示圖示，初始 alpha 設為 0 (隱藏) -->
    <!-- 使用 tools:alpha="1" 讓你在 Android Studio 的設計畫面中看得到它們 -->

    <ImageView
        android:id="@+id/imageView_accPic"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="80dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView_accData"
        app:srcCompat="@drawable/ppp" />

    <ImageView
        android:id="@+id/iv_up"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:alpha="0"
        android:elevation="10dp"
        app:layout_constraintBottom_toTopOf="@+id/imageView_accPic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/acc_up"
        tools:alpha="1" />

    <ImageView
        android:id="@+id/iv_down"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:alpha="0"
        android:elevation="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView_accPic"
        app:srcCompat="@drawable/acc_down"
        tools:alpha="1" />

    <ImageView
        android:id="@+id/iv_left"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:alpha="0"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/imageView_accPic"
        app:layout_constraintEnd_toStartOf="@+id/imageView_accPic"
        app:layout_constraintTop_toTopOf="@+id/imageView_accPic"
        app:srcCompat="@drawable/acc_left"
        tools:alpha="1" />

    <ImageView
        android:id="@+id/iv_right"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:alpha="0"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/imageView_accPic"
        app:layout_constraintStart_toEndOf="@+id/imageView_accPic"
        app:layout_constraintTop_toTopOf="@+id/imageView_accPic"
        app:srcCompat="@drawable/acc_right"
        tools:alpha="1" />

    <ImageView
        android:id="@+id/iv_z_in"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="5dp"
        android:alpha="0"
        android:elevation="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView_accPic"
        app:srcCompat="@drawable/acc_z_in"
        tools:alpha="1" />

    <ImageView
        android:id="@+id/iv_z_out"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="192dp"
        android:layout_marginEnd="28dp"
        android:alpha="0"
        android:elevation="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/acc_z_out"
        tools:alpha="1" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_v"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

</androidx.constraintlayout.widget.ConstraintLayout>