<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 六張花卉圖片對應的 Drawable 資源陣列 -->
    <array name="flower_images">
        <item>@drawable/flower1</item>
        <item>@drawable/flower2</item>
        <item>@drawable/flower3</item>
        <item>@drawable/flower4</item>
        <item>@drawable/flower5</item>
        <item>@drawable/flower6</item>
    </array>

    <!-- 圖片檔名字串陣列，可透過 resources.getStringArray() 讀取 -->
    <string-array name="flower_file_names">
        <!-- 改為保留原始 PNG，避免再次壓縮造成畫質損失 -->
        <item>flower1.png</item>
        <item>flower2.png</item>
        <item>flower3.png</item>
        <item>flower4.png</item>
        <item>flower5.png</item>
        <item>flower6.png</item>
    </string-array>

    <!-- 六種花卉的繁體中文名稱 -->
    <string-array name="flower_names">
        <item>玫瑰</item>
        <item>向日葵</item>
        <item>櫻花</item>
        <item>鬱金香</item>
        <item>薰衣草</item>
        <item>荷花</item>
    </string-array>
</resources>
