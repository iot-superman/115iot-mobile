<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D9E5EE"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="100dp">

        <TextView
            android:id="@+id/textView_data1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cat 1"
            android:textColor="#3F51B5"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textView_data2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="100dp"
            android:text="Dog 1"
            android:textColor="#4CAF50"
            android:textSize="24sp"
            android:textStyle="bold" />

    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomAppBar_id"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="bottom"
        android:background="#F4D644"
        android:paddingStart="0dp"
        android:paddingEnd="60dp"
        app:itemIconSize="48dp"
        app:itemIconTint="@null"
        app:itemRippleColor="@null"
        app:itemTextAppearanceActive="@style/BottomNavText"
        app:itemTextAppearanceInactive="@style/BottomNavText"
        app:labelVisibilityMode="selected"
        app:menu="@menu/bottom_menu" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floatingActionButton_id"
        android:layout_width="52dp"
        android:layout_height="73dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="52dp"
        android:contentDescription="@string/fab_add_description"
        app:backgroundTint="#E1D5F5"
        app:layout_anchor="@id/bottomAppBar_id"
        app:layout_anchorGravity="top|end"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Menu9.FAB"
        app:srcCompat="@android:drawable/ic_menu_close_clear_cancel"
        app:tint="#3F2B63" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>