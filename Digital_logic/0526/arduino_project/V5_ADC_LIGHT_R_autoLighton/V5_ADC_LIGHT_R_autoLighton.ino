/*

=====================================
Arduino 光敏電阻自動小夜燈
=====================================

功能：

光線變暗：
LED 自動亮起

光線變亮：
LED 自動熄滅


=====================================
接線方式
=====================================

           5V
            |
          [2.2K]
            |
            +---------> A2
            |
      [ 光敏電阻 ]
            |
           GND


=====================================
LED 接線
=====================================

(LED)--Arduino D13 ----[220Ω]----|>|---- GND


=====================================
原理
=====================================

暗：
光敏電阻阻值變大
A2 電壓上升
ADC 數值變大
LED 亮

亮：
光敏電阻阻值變小
A2 電壓下降
ADC 數值變小
LED 滅

=====================================

*/


// =====================================
// 光敏電阻 Analog Pin
// =====================================
const int PhotoPin = A2;


// =====================================
// LED Pin
// =====================================
const int LedPin = 13;


// =====================================
// ADC 數值
// =====================================
int adcValue = 0;


// =====================================
// 電壓值
// =====================================
float voltage = 0.0;


// =====================================
// 小夜燈門檻值
//
// ADC > 700
// 判定為「太暗」
//
// 可自行調整
// =====================================

//閾值
const int DarkThreshold = 800;


void setup() {

  // =====================================
  // LED 腳位輸出模式
  // =====================================
  pinMode(LedPin, OUTPUT);


  // =====================================
  // LED 初始關閉
  // =====================================
  digitalWrite(LedPin, LOW);


  // =====================================
  // Serial 初始化
  // =====================================
  Serial.begin(115200);

  Serial.println("Auto Night Light");
}


void loop() {

  // =====================================
  // 讀取光敏電阻 ADC
  // =====================================
  adcValue = analogRead(PhotoPin);


  // =====================================
  // ADC 轉電壓
  // 老師版 /1024.0
  // =====================================
  voltage = adcValue * (5.0 / 1024.0);


  // =====================================
  // 顯示 ADC 與電壓
  // =====================================
  Serial.print("ADC Value = ");

  Serial.print(adcValue);

  Serial.print("    Voltage = ");

  Serial.print(voltage, 2);

  Serial.print(" V");


  // =====================================
  // 太暗
  // LED 開啟
  // =====================================
  if (adcValue > DarkThreshold) {

    digitalWrite(LedPin, HIGH);

    Serial.println("    LED ON");
//    delay(1000);
  }

  // =====================================
  // 夠亮
  // LED 關閉
  // =====================================
  else {

    digitalWrite(LedPin, LOW);

    Serial.println("    LED OFF");
//     delay(500);
  }


  // =====================================
  // 延遲 200ms
  // =====================================
  delay(200);
}
