/*

=====================================
光敏電阻（Photo Resistor / LDR）分壓電路
=====================================

接線方式：

           5V
            |
          [2.2K]
            |
            +---------> A2
            |
      [ 光敏電阻 ]
            |
           GND


=====================================
原理說明
=====================================

光敏電阻特性：

亮  -> 阻值變小
暗  -> 阻值變大


=====================================
目前這種接法：
=====================================

暗：
光敏電阻阻值變大
A2 電壓上升
ADC 數值變大

亮：
光敏電阻阻值變小
A2 電壓下降
ADC 數值變小


=====================================
實際可能阻值
=====================================

很暗：
50KΩ ~ 200KΩ

一般室內：
5KΩ ~ 20KΩ

強光：
幾百Ω ~ 幾KΩ


=====================================
Arduino UNO ADC
=====================================

10-bit ADC

範圍：
0 ~ 1023

老師版換算：
Voltage = ADC × (5.0 / 1024.0)

=====================================

*/


// =====================================
// Arduino A2 光敏電阻讀取範例
// 使用 analogRead() 讀取 A2 電壓
// =====================================


// =====================================
// A2 類比輸入腳位
// =====================================
const int AnalogPin = A2;


// =====================================
// ADC 數值
// 範圍：0 ~ 1023
// =====================================
int adcValue = 0;


// =====================================
// 電壓值
// =====================================
float voltage = 0.0;


void setup() {

  // =====================================
  // Serial 初始化
  // 115200 baud
  // =====================================
  Serial.begin(115200);

  Serial.println("Photo Resistor Voltage Read");
}


void loop() {

  // =====================================
  // 讀取 A2 ADC 數值
  // =====================================
  adcValue = analogRead(AnalogPin);


  // =====================================
  // ADC 轉換成電壓
  //
  // Arduino UNO:
  // 10-bit ADC
  //
  // 0     -> 0V
  // 1023  -> 約 5V
  //
  // 老師版：
  // 使用 /1024.0
  // =====================================
  voltage = adcValue * (5.0 / 1024.0);


  // =====================================
  // Serial Monitor 顯示
  // =====================================
  Serial.print("ADC Value = ");

  Serial.print(adcValue);

  Serial.print("    Voltage = ");

  // 顯示小數點後 2 位
  Serial.print(voltage, 2);

  Serial.println(" V");


  // =====================================
  // 延遲 500ms
  // =====================================
  delay(500);
}
