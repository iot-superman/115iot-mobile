// =====================================
// Arduino A2 讀取電壓範例
// 使用 analogRead() 讀取 A2 電壓
// =====================================

// =====================================
// A2 腳位
// =====================================
const int AnalogPin = A2;

// =====================================
// ADC 數值
// =====================================
int adcValue = 0;

// =====================================
// 電壓值
// =====================================
float voltage = 0.0;

void setup() {

  // =====================================
  // Serial 初始化
  // =====================================
  Serial.begin(115200);

  Serial.println("Arduino A2 Voltage Read");
}

void loop() {

  // =====================================
  // 讀取 A2 ADC 值
  // 範圍：
  // 0 ~ 1023
  // =====================================
  adcValue = analogRead(AnalogPin);

  // =====================================
  // ADC 轉電壓
  //
  // Arduino UNO:
  // 10-bit ADC
  //
  // 0     -> 0V
  // 1023  -> 5V (老師版)
  // =====================================
  voltage = adcValue * (5.0 / 1024.0);  //1024(老師版)

  // =====================================
  // Serial 顯示
  // =====================================
  Serial.print("ADC Value = ");

  Serial.print(adcValue);

  Serial.print("    Voltage = ");

  Serial.print(voltage);

  Serial.println(" V");

  delay(500);
}
