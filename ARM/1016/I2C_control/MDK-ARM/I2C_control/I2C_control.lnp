".\i2c_control\main.o"
".\i2c_control\stm32f0xx_it.o"
".\i2c_control\stm32f0xx_hal_msp.o"
".\i2c_control\touch_control.o"
".\i2c_control\stm32f0xx_hal_i2c.o"
".\i2c_control\stm32f0xx_hal_i2c_ex.o"
".\i2c_control\stm32f0xx_hal_rcc.o"
".\i2c_control\stm32f0xx_hal_rcc_ex.o"
".\i2c_control\stm32f0xx_hal.o"
".\i2c_control\stm32f0xx_hal_gpio.o"
".\i2c_control\stm32f0xx_hal_dma.o"
".\i2c_control\stm32f0xx_hal_cortex.o"
".\i2c_control\stm32f0xx_hal_pwr.o"
".\i2c_control\stm32f0xx_hal_pwr_ex.o"
".\i2c_control\stm32f0xx_hal_flash.o"
".\i2c_control\stm32f0xx_hal_flash_ex.o"
